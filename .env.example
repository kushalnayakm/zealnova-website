# Google Maps Embed API key (Maps Embed API must be enabled in Google Cloud Console).
# Restrict the key to your production domain.
# Map always uses hardcoded coordinates 12.8812393, 77.6373999 (never geocodes the postal address).
VITE_GOOGLE_MAPS_API_KEY=

# EmailJS — contact form enquiry delivery to services@zealnova.in
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (e.g. Gmail) connected to services@zealnova.in
# 3. Create an Email Template with these variables:
#    {{name}}, {{company}}, {{email}}, {{phone}}, {{message}}, {{subject}}, {{reply_to}}
#    Set the template "To" field to services@zealnova.in
#    Example template body:
#      Name: {{name}}
#      Company: {{company}}
#      Email: {{email}}
#      Phone: {{phone}}
#      Message: {{message}}
# 4. Copy your Public Key, Service ID, and Template ID below
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
